{
  "name": "@tackbok/mobile",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=beta expo start",
    "android": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 APP_VARIANT=beta expo run:android",
    "ios": "APP_VARIANT=beta expo run:ios",
    "prebuild": "APP_VARIANT=beta expo prebuild --clean",
    "update:development": "APP_VARIANT=beta ANDROID_STORE=google GALAXY_BILLING_MODE=PRODUCTION bunx eas update --channel development --environment development --auto",
    "update:preview": "APP_VARIANT=production ANDROID_STORE=google GALAXY_BILLING_MODE=PRODUCTION bunx eas update --channel preview --environment preview --auto",
    "update:production": "APP_VARIANT=production ANDROID_STORE=google GALAXY_BILLING_MODE=PRODUCTION bunx eas update --channel production --environment production --auto",
    "update:galaxy": "APP_VARIANT=production ANDROID_STORE=samsung GALAXY_BILLING_MODE=PRODUCTION bunx eas update --platform android --channel production-galaxy --environment production --auto",
    "update:galaxy-test": "APP_VARIANT=production ANDROID_STORE=samsung GALAXY_BILLING_MODE=TEST bunx eas update --platform android --channel galaxy-test --environment production --auto",
    "generate:themes": "bun run src/lib/theme/generate-theme-artifacts.ts",
    "generate:themes:verify": "bun run generate:themes && bun run test:theme",
    "cloud-sync:test": "jest src/lib/cloudSync src/lib/zip/core/core-safety.test.ts src/lib/zip/core/gzip-codec.test.ts src/lib/analytics/events.test.ts src/lib/i18n/translations/translations.test.ts --runInBand --no-watchman && bun test scripts/cloud-sync",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:jest --runInBand --no-watchman && bun run test:integration",
    "test:jest": "jest",
    "test:integration": "bun test scripts/cloud-sync scripts/db",
    "test:theme": "jest src/lib/theme/theme-registry.test.ts src/lib/theme/metro-config.test.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10",
    "@expo-google-fonts/baskervville": "^0.4.1",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/gloria-hallelujah": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/ui": "~58.0.27",
    "@legendapp/list": "^3.7.1",
    "@lodev09/react-native-true-sheet": "^4.0.1",
    "@tanstack/react-query": "^5.105.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-auth-session": "~58.0.17",
    "expo-background-task": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.7.1",
    "lucide-react-native": "^1.69.0",
    "posthog-react-native": "^4.85.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "~0.13.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-purchases": "10.8.1",
    "react-native-purchases-store-galaxy": "10.8.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-skia": "3.9.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.4",
    "unicode-segmenter": "^0.17.3",
    "uniwind": "^1.13.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.9",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~58.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "testPathIgnorePatterns": [
      "<rootDir>/scripts/cloud-sync/",
      "<rootDir>/scripts/db/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!.*((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}

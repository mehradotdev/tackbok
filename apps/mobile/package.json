{
  "name": "@tackbok/mobile",
  "version": "0.5.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate:themes": "bun run src/lib/theme/generate-theme-artifacts.ts",
    "generate:themes:verify": "bun run generate:themes && bun run test:theme",
    "lint": "expo lint",
    "test": "bun run test:jest",
    "test:jest": "jest",
    "test:theme": "jest src/lib/theme/theme-registry.test.ts src/lib/theme/metro-config.test.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/gloria-hallelujah": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/ui": "~56.0.15",
    "@legendapp/list": "^3.0.0",
    "@lodev09/react-native-true-sheet": "^3.10.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.90.20",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "expo": "~56.0.8",
    "expo-constants": "~56.0.16",
    "expo-dev-client": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.16",
    "expo-image-picker": "~56.0.15",
    "expo-linking": "~56.0.13",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.8",
    "expo-sharing": "~56.0.15",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.3",
    "react-native": "0.85.3",

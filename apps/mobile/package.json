    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/jest": "29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~56.0.0",
    "drizzle-kit": "^0.31.8",

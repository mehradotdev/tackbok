{
  "name": "@tackbok/mobile",
  "version": "0.6.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=beta expo start",
    "android": "APP_VARIANT=beta expo run:android",
    "ios": "APP_VARIANT=beta expo run:ios",
    "prebuild": "APP_VARIANT=beta expo prebuild --clean",
    "generate:themes": "bun run src/lib/theme/generate-theme-artifacts.ts",
    "generate:themes:verify": "bun run generate:themes && bun run test:theme",
    "cloud-sync:test": "jest src/lib/cloudSync src/lib/zip/core/core-safety.test.ts src/lib/zip/core/gzip-codec.test.ts src/lib/analytics/events.test.ts src/lib/i18n/translations/translations.test.ts --runInBand --no-watchman && bun test scripts/cloud-sync",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:jest",
    "test:jest": "jest",
    "test:theme": "jest src/lib/theme/theme-registry.test.ts src/lib/theme/metro-config.test.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo-google-fonts/baskervville": "^0.4.1",
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/gloria-hallelujah": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/ui": "~57.0.7",
    "@legendapp/list": "^3.0.0",
    "@lodev09/react-native-true-sheet": "^3.10.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.90.20",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.7",
    "expo-auth-session": "~57.0.6",
    "expo-background-task": "~57.0.8",
    "expo-constants": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-task-manager": "~57.0.8",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.17.0",
    "posthog-react-native": "^4.57.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-audio-api": "~0.12.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-purchases": "^10.8.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "^5.1.1",
    "react-native-worklets": "0.10.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/jest": "29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "~57.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "globalSetup": "<rootDir>/jest.global-setup.js",
    "testPathIgnorePatterns": [
      "<rootDir>/scripts/cloud-sync/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!.*((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  },
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "unrs-resolver"
  ]
}

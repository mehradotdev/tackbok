{
  "formatVersion": 1,
  "fixtureFormat": "tackbok-phase0-scenario-v1",
  "notes": "Aliases are stable test labels, not protocol hashes. Phase 2 must materialize canonical version bodies, replace parent aliases with their computed hashes, and then assert these outcomes.",
  "scenarios": [
    { "id": "tiny-vault", "area": "format", "given": { "entities": 1, "blobs": 0 }, "expect": { "valid": true, "heads": ["entry-create"] } },
    { "id": "linear-history", "area": "ancestry", "given": { "graph": { "v1": [], "v2": ["v1"], "v3": ["v2"] } }, "expect": { "heads": ["v3"], "descends": [["v3", "v1"]] } },
    { "id": "symmetric-fork", "area": "ancestry", "given": { "graph": { "base": [], "left": ["base"], "right": ["base"] } }, "expect": { "heads": ["left", "right"], "maximalCommonAncestors": ["base"] } },
    { "id": "asymmetric-fork", "area": "ancestry", "given": { "graph": { "base": [], "left1": ["base"], "left2": ["left1"], "right": ["base"] } }, "expect": { "heads": ["left2", "right"], "maximalCommonAncestors": ["base"] } },
    { "id": "three-head-fork", "area": "ancestry", "given": { "graph": { "base": [], "a": ["base"], "b": ["base"], "c": ["base"] } }, "expect": { "heads": ["a", "b", "c"], "resolvedParentCount": 3 } },
    { "id": "criss-cross-multiple-merge-base", "area": "ancestry", "given": { "graph": { "root": [], "a1": ["root"], "b1": ["root"], "a2": ["a1", "b1"], "b2": ["a1", "b1"] } }, "expect": { "heads": ["a2", "b2"], "maximalCommonAncestors": ["a1", "b1"], "fallback": "preservation-first" } },
    { "id": "set-merge-fork", "area": "conflicts", "given": { "base": ["tag-a"], "candidates": [["tag-a", "tag-b"], ["tag-a", "tag-c"]] }, "expect": { "set": ["tag-a", "tag-b", "tag-c"] } },
    { "id": "text-conflict-recovered-copy", "area": "conflicts", "given": { "baseText": "base", "candidates": ["left", "right"], "originalAssetIds": ["asset-1"] }, "expect": { "primary": "lowest-representative-hash", "recoveredCopies": 1, "assetIdRule": "sha256(tackbok-recovered-asset-v1 + recoveredEntryId + originalAssetId)", "blobHashPreserved": true } },
    { "id": "scalar-conflict-stored-alternates", "area": "conflicts", "given": { "field": "mood", "candidates": ["Calm", "Joyful", "Neutral"] }, "expect": { "primary": "lowest-representative-hash", "storedAlternates": 2, "recoveredCopies": 0 } },
    { "id": "delete-edit-fork", "area": "conflicts", "given": { "heads": ["concurrent-delete", "concurrent-edit"] }, "expect": { "editSurvives": true, "recoveredWhenNeeded": true } },
    { "id": "raced-double-resolution", "area": "determinism", "given": { "devices": ["device-a", "device-b"], "sameHeads": true }, "expect": { "canonicalBytesEqual": true, "hashesEqual": true, "systemMetadataHasDeviceFields": false } },
    { "id": "dirty-local-vs-pulled-remote", "area": "outbox", "given": { "base": "v1", "remote": "remote-v2", "localGeneration": 2 }, "expect": { "provisionalParents": ["v1"], "headsIncludeProvisional": true, "remoteDoesNotOverwriteDirtyState": true } },
    { "id": "dirty-local-delete-vs-remote-edit", "area": "outbox", "given": { "base": "v1", "remote": "remote-edit", "localAction": "delete" }, "expect": { "provisionalKind": "edit", "provisionalDeleted": true, "remoteEditSurvives": true } },
    { "id": "generation-n-plus-one-during-sync", "area": "outbox", "given": { "capturedGeneration": 7, "settleGeneration": 8, "remoteSetAdd": "tag-remote" }, "expect": { "clearOutbox": false, "nextBaseHeads": ["provisional-generation-7"], "generation8Parents": ["provisional-generation-7"], "remoteSetAddSurvivesFollowUp": true, "spuriousRecoveredCopy": false } },
    { "id": "clean-then-local-edit-before-apply", "area": "outbox", "given": { "capturedGeneration": 3, "applyGeneration": 4 }, "expect": { "applyDomainWrite": false, "localEditPreserved": true, "remoteHeadStaged": true, "falseAncestry": false } },
    { "id": "publish-crash-blob", "area": "publish-order", "given": { "crashAfterStep": 1 }, "expect": { "visibleInvalidResolution": false, "retrySafe": true } },
    { "id": "publish-crash-provisional", "area": "publish-order", "given": { "crashAfterStep": 2 }, "expect": { "visibleInvalidResolution": false, "retrySafe": true } },
    { "id": "publish-crash-recovery-init", "area": "publish-order", "given": { "crashAfterStep": 3 }, "expect": { "visibleInvalidResolution": false, "retrySafe": true } },
    { "id": "publish-crash-resolution", "area": "publish-order", "given": { "crashAfterStep": 4 }, "expect": { "dependenciesComplete": true, "retrySafe": true } },
    { "id": "vault-revocation-journal-deleted", "area": "revocation", "given": { "kind": "journal-deleted", "staleOfflineDeviceReturns": true, "purgeInterrupted": true, "lateWriter": true }, "expect": { "pushAfterObservation": false, "localData": "wiped", "disconnect": true, "purgeResumes": true, "residueReswept": true } },
    { "id": "vault-revocation-backup-deleted", "area": "revocation", "given": { "kind": "backup-deleted", "staleOfflineDeviceReturns": true, "purgeInterrupted": true }, "expect": { "pushAfterObservation": false, "localData": "kept", "disconnect": true, "purgeResumes": true } },
    { "id": "concurrent-destructive-actions", "area": "revocation", "given": { "markers": ["backup-deleted", "journal-deleted"], "deviceViews": { "a": ["backup-deleted", "journal-deleted"], "b": ["journal-deleted"], "c": ["backup-deleted"] } }, "expect": { "a": "wipe", "b": "wipe", "c": "keep", "allDisconnected": true, "vaultDead": true, "retryIdempotent": true } },
    { "id": "initial-seeding-raced-edit", "area": "seeding", "given": { "seedCursor": "entry-100", "editedEntity": "entry-050", "outboxFullyDrainedBeforeCursor": true }, "expect": { "seededAgain": false, "editPreserved": true } },
    { "id": "initial-seeding-ahead-of-cursor-edit", "area": "seeding", "given": { "seedCursor": "entry-100", "editedEntity": "entry-900", "outboxFullyDrainedBeforeCursor": true }, "expect": { "seedScanRecognizesPublishedState": true, "duplicateBranch": false } },
    { "id": "profile-name-photo-conflict", "area": "conflicts", "given": { "fields": ["displayName", "photo"], "candidates": 2 }, "expect": { "primary": "lowest-representative-hash", "storedAlternates": 1, "emailPresentInVersion": false } },
    { "id": "blob-multiple-obligations", "area": "media", "given": { "obligations": { "complete": 1, "pending": 1 }, "referenceCount": 0 }, "expect": { "bytesDeleted": false } },
    { "id": "zip-v1-stable-identity-roundtrip", "area": "zip", "given": { "backupVersion": 1, "ids": ["entry", "tag", "custom-prompt", "asset", "profile"] }, "expect": { "sameIdsAfterRoundtrip": true, "unknownOptionalFieldsAcceptedByOldImporter": true } },
    { "id": "child-before-parent-delivery", "area": "validation", "given": { "delivery": ["child", "parent"] }, "expect": { "childInitially": "incomplete", "childFinally": "complete", "appliedBeforeParent": false } },
    { "id": "missing-parent", "area": "validation", "given": { "parent": "unavailable" }, "expect": { "state": "incomplete", "materialized": false, "entityDegraded": true } },
    { "id": "corrupt-parent", "area": "validation", "given": { "parentHashMatchesBody": false }, "expect": { "quarantined": true, "materialized": false } },
    { "id": "cross-entity-parent", "area": "validation", "given": { "childEntity": "entry-a", "parentEntity": "entry-b" }, "expect": { "quarantined": true, "materialized": false } },
    { "id": "missing-recovery-dependency", "area": "validation", "given": { "resolutionPresent": true, "recoveryInitPresent": false }, "expect": { "resolution": "incomplete", "materialized": false } },
    { "id": "ancestry-cycle-rejection", "area": "validation", "given": { "graph": { "a": ["b"], "b": ["a"] } }, "expect": { "quarantined": ["a", "b"], "materialized": false } },
    { "id": "tombstoned-tag-concurrent-reference", "area": "multi-entity", "given": { "tagTombstoned": true, "survivingEntryReference": true, "lastLiveTagAvailable": true }, "expect": { "recoveredTag": true, "entryReferenceRewritten": true, "publishTagBeforeEntry": true } }

{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "beta"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_TACKBOK_CLOUD_SYNC_ROLLOUT": "all"
      }
    },
    "device-evidence": {
      "distribution": "internal",
      "channel": "device-evidence",
      "env": {
        "APP_VARIANT": "beta",
        "TACKBOK_V7_DEVICE_PROBES": "1",
        "EXPO_PUBLIC_TACKBOK_CLOUD_SYNC_ROLLOUT": "all"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_TACKBOK_CLOUD_SYNC_ROLLOUT": "all"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}

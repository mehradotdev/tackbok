---
import { Image } from 'astro:assets';
import { storeLinks } from '~/lib/store-links';

interface Props {
  /** `lg` (58px) for the page's main call to action, `md` (52px) inside content. */
  size?: 'md' | 'lg';
  class?: string;
}

// Badges keep <Image>'s default lazy loading and ask for low priority, even in
// the hero, so they never compete with the hero screenshot (the Largest
// Contentful Paint).
const { size = 'lg', class: className } = Astro.props;
const height = size === 'lg' ? 58 : 52;
---

<div class:list={['flex flex-wrap items-center gap-3', className]}>
  {storeLinks.map((store) => (
    <a
      class="inline-flex shrink-0 rounded-lg shadow-lg shadow-sage-deep/15 transition duration-150 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-sage-deep/25 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[color-mix(in_srgb,var(--color-sage)_58%,white)]"
      href={store.websiteHref}
      target="_blank"
      rel="noopener noreferrer">
      <Image
        class:list={['w-auto rounded-lg', size === 'lg' ? 'h-[58px]' : 'h-[52px]']}
        src={store.badge}
        height={height}
        alt={store.label}
        fetchpriority="low"
      />
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  ))}
</div>

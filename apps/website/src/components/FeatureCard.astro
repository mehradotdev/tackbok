---
import type { ImageMetadata } from 'astro';
import PhoneFrame from './PhoneFrame.astro';

export interface Props {
  eyebrow: string;
  title: string;
  copy: string;
  /** Screenshot, or the poster of `video`. */
  src: ImageMetadata;
  alt: string;
  video?: { webm: string; mp4: string };
  class?: string;
}

const { eyebrow, title, copy, src, alt, video, class: className } = Astro.props;
---

<article
  class:list={[
    'card overflow-hidden rounded-[2rem] border border-line bg-paper shadow-xl shadow-ink/5',
    className,
  ]}>
  <div class="card-body flex-none gap-3 p-7 sm:min-h-[240px] sm:p-9">
    <p class="mb-0 grow-0 text-xs font-bold tracking-[0.14em] text-sage uppercase">
      {eyebrow}
    </p>
    <h3 class="card-title text-3xl leading-tight tracking-tight">{title}</h3>
    <p class="mb-0 grow-0 text-base leading-relaxed text-ink-soft">{copy}</p>
  </div>
  <figure class="mx-auto mt-auto mb-10 w-[min(234px,70%)] overflow-visible pt-2 sm:w-[240px]">
    <PhoneFrame src={src} alt={alt} video={video} loading="lazy" sizes="240px" />
  </figure>
</article>

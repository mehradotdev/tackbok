---
import type { ImageMetadata } from 'astro';
import PhoneFrame from './PhoneFrame.astro';

export interface Props {
  eyebrow: string;
  title: string;
  copy: string;
  /** Screenshot, or the poster of `video`. */
  src: ImageMetadata;
  alt: string;
  video?: string;
}

const { eyebrow, title, copy, src, alt, video } = Astro.props;
---

<!-- In a three-card grid, the last card spans both columns at the two-column
     breakpoint. -->
<article class="card overflow-hidden rounded-[2rem] border border-line bg-paper shadow-xl shadow-ink/5 md:last:col-span-2 lg:last:col-span-1">
  <div class="card-body flex-none gap-3 p-7 sm:min-h-[240px] sm:p-9">
    <p class="mb-0 grow-0 text-xs font-bold tracking-[0.14em] text-sage-deep uppercase">
      {eyebrow}
    </p>
    <h3 class="card-title text-3xl leading-tight tracking-tight">{title}</h3>
    <p class="mb-0 grow-0 text-base leading-relaxed text-ink-soft">{copy}</p>
  </div>
  <figure class="mx-auto mt-auto mb-10 w-[min(234px,70%)] overflow-visible pt-2 sm:w-[240px]">
    <!-- With these sizes, a card showing the hero screenshot picks the same
         srcset file as the hero, so the voice-note poster is a cache hit. Keep
         them in step with PhoneFrame's default sizes. -->
    <PhoneFrame src={src} alt={alt} video={video} loading="lazy" sizes="240px" />
  </figure>
</article>

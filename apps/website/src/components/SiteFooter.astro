---
import { ExternalLink } from '@lucide/astro';

const supportEmail = 'tackbok.support@mehra.dev';
---

<footer class="border-t border-line bg-paper-deep pt-[3.2rem] pb-6">
  <div
    class="mx-auto flex w-full max-w-[1240px] items-start justify-between gap-12 px-6 max-sm:flex-col sm:px-8 lg:px-12"
  >
    <div>
      <a
        class="inline-flex items-center gap-[0.7rem] text-[1.15rem] font-[760] tracking-[-0.02em] text-ink no-underline focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[color-mix(in_srgb,var(--sage)_58%,white)]"
        href="/"
        aria-label="Tackbok home"
      >
        <img
          class="rounded-[0.7rem] shadow-[0_6px_18px_rgba(52,75,55,0.14)]"
          src="/icon.png"
          width="40"
          height="40"
          alt=""
        />
        <span>Tackbok</span>
      </a>
      <p class="mt-3 mb-0 text-[0.88rem] text-ink-soft">
        A private place to notice what matters.
      </p>
    </div>

    <nav
      class="flex max-w-[640px] flex-wrap items-center justify-end gap-[clamp(1rem,2vw,1.8rem)] max-sm:justify-start"
      aria-label="Footer navigation"
    >
      <a class="nav-link" href="/#features">Features</a>
      <a class="nav-link" href="/faq">FAQ</a>
      <a class="nav-link" href="/terms">Terms</a>
      <a class="nav-link" href="/privacy">Privacy policy</a>
      <a class="nav-link" href={`mailto:${supportEmail}`}>Support</a>
      <a
        class="inline-flex items-center gap-1 nav-link"
        href="https://github.com/mehradotdev/tackbok"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>GitHub</span>
        <ExternalLink class="size-3.5 opacity-70" />
      </a>
    </nav>
  </div>

  <div
    class="mx-auto mt-11 flex w-full max-w-[1240px] justify-center border-t border-line px-6 pt-5 text-center text-[0.76rem] text-ink-soft sm:px-8 lg:px-12"
  >
    <p>
      Made with ❤️🧡💛 and care by <a
        class="font-medium underline underline-offset-2 transition-colors duration-150 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
        href="https://mehra.dev"
        target="_blank"
        rel="noopener noreferrer">Mehra Dot Dev</a
      >.
    </p>
  </div>
</footer>

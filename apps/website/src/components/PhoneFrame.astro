---
import { Pause, Play } from '@lucide/astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** The screenshot, or the poster when `video` is set. The poster stays the
      accessible content; the video only decorates it. */
  src: ImageMetadata;
  alt: string;
  /** Set on the first hero screenshot, the likely Largest Contentful Paint. */
  priority?: boolean;
  /** Screenshots below the fold load lazily. */
  loading?: 'eager' | 'lazy';
  /** Rendered width of the screenshot, for picking a srcset candidate. */
  sizes?: string;
  /** URL of a short, silent, looping H.264 MP4 screen recording with the
      same aspect ratio as `src`. It loads and plays only while on screen, never
      with reduced motion, and has a pause button (see the script below). Until
      it plays, the lazy poster image shows. */
  video?: string;
}

const {
  src,
  alt,
  priority = false,
  loading = 'eager',
  sizes = '(max-width: 640px) 234px, 254px',
  video,
} = Astro.props;

// Posters are recorded at 540px wide; never ask for a larger copy.
const widths = [300, 540, 810].filter((width) => width <= src.width);
---

<!-- w-full: a flex parent (daisyUI `.card figure`) would otherwise shrink the
     frame to its content, and an unloaded lazy image measures 0×0. -->
<div class="relative isolate w-full" data-phone-video={video ? '' : undefined}>
  <!-- Generic side buttons (volume, then power); the body covers their inner ends. -->
  <span
    aria-hidden="true"
    class="absolute top-[17%] -right-[7px] h-[14%] w-2.5 rounded-sm bg-ink-soft"></span>
  <span
    aria-hidden="true"
    class="absolute top-[35%] -right-[7px] h-[8%] w-2.5 rounded-sm bg-ink-soft"></span>
  <div class="relative rounded-[2.6rem] border border-ink-soft bg-ink p-2 shadow-[0_24px_55px_color-mix(in_srgb,var(--color-ink)_25%,transparent)] ring-2 ring-paper-deep">
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={priority ? 'high' : undefined}
      class="block h-auto w-full rounded-[2.1rem]"
    />
    <!-- Hole-punch selfie camera, centred in the status bar. A playing screen
         recording covers it with the simulator's own camera cut-out. -->
    <span
      aria-hidden="true"
      class="absolute top-[3.6%] left-1/2 aspect-square w-[4.6%] -translate-x-1/2 rounded-full bg-[radial-gradient(circle_at_35%_35%,#2c3138_0%,#0b0c0e_55%)] ring-1 ring-white/10"></span>
    {video && (
      <video
        class="absolute top-2 left-2 h-[calc(100%-1rem)] w-[calc(100%-1rem)] rounded-[2.1rem] object-cover opacity-0 transition-opacity duration-300 data-playing:opacity-100"
        aria-hidden="true"
        tabindex="-1"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none">
        <!-- The script copies data-src to src on first play, so no browser can
             fetch a clip early, and none is fetched with reduced motion. -->
        <source data-src={video} type="video/mp4" />
      </video>
    )}
    <!-- Moving content longer than 5 seconds needs a way to stop it (WCAG
         2.2.2). Hidden until the script runs, and with reduced motion. -->
    {video && (
      <button
        type="button"
        class="group btn absolute right-4 bottom-4 btn-circle border-0 bg-ink/75 text-paper shadow-none btn-sm hover:bg-ink"
        aria-label="Pause animation"
        hidden>
        <Pause class="size-4 group-data-paused:hidden" aria-hidden="true" />
        <Play class="hidden size-4 group-data-paused:block" aria-hidden="true" />
      </button>
    )}
  </div>
</div>

<script>
  // Play each recording only while it is on screen, unless the visitor prefers
  // reduced motion or pressed pause. The clip's sources are attached on first
  // play, and the video fades in over the poster image once it really plays,
  // so visitors whose browser blocks playback or the script keep the poster.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const frames = document.querySelectorAll<HTMLElement>('[data-phone-video]');

  function update(frame: HTMLElement) {
    const video = frame.querySelector('video');
    const button = frame.querySelector('button');
    if (!video || !button) return;

    const userPaused = button.dataset.paused !== undefined;
    button.hidden = reducedMotion.matches;
    button.setAttribute('aria-label', userPaused ? 'Play animation' : 'Pause animation');

    if (frame.dataset.visible !== undefined && !reducedMotion.matches && !userPaused) {
      const pending = video.querySelectorAll<HTMLSourceElement>('source[data-src]');
      if (pending.length > 0) {
        for (const source of pending) {
          source.src = source.dataset.src ?? '';
          delete source.dataset.src;
        }
        video.load();
      }
      // Autoplay of a muted video can still be refused (for example in Low
      // Power Mode); the poster then stays, which is fine.
      video.play().catch(() => {});
    } else if (!video.paused) {
      video.pause();
    }
    // With reduced motion, fade back to the poster, which the alt text describes.
    if (reducedMotion.matches) delete video.dataset.playing;
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const frame = target as HTMLElement;
        if (isIntersecting) frame.dataset.visible = '';
        else delete frame.dataset.visible;
        update(frame);
      }
    },
    { rootMargin: '200px 0px' },
  );

  for (const frame of frames) {
    const video = frame.querySelector('video');
    video?.addEventListener('playing', () => (video.dataset.playing = ''));
    frame.querySelector('button')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      if (button.dataset.paused === undefined) button.dataset.paused = '';
      else delete button.dataset.paused;
      update(frame);
    });
    observer.observe(frame);
  }

  reducedMotion.addEventListener('change', () => frames.forEach(update));
</script>

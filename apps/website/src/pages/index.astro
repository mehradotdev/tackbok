---
import { Image } from 'astro:assets';
import tackbokEditSrc from '~/assets/tackbok_edit_page.png';
import tackbokHomeSrc from '~/assets/tackbok_home_page.png';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Layout from '~/layouts/main.astro';

const WAITLIST_URL = 'https://forms.gle/A5bGfGJLoEipsauu6';
const GITHUB_URL = 'https://github.com/mehradotdev/tackbok';
const GOOGLE_PLAY_URL = 'https://play.google.com/store/apps/details?id=dev.mehra.tackbok';
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/jGTWBEWq';

const features = [
  {
    number: '01',
    title: 'Capture the whole memory',
    copy: 'Write freely, then add photos, clearer voice memos, moods, and tags when words are not enough.',
  },
  {
    number: '02',
    title: 'Find a gentle starting point',
    copy: 'Choose focus areas and use thoughtful prompts whenever the blank page feels a little too blank.',
  },
  {
    number: '03',
    title: 'Build your own rhythm',
    copy: 'Set an optional daily reminder at the time that works for you. Tap it to start with a relevant prompt.',
  },
  {
    number: '04',
    title: 'Make it feel like yours',
    copy: 'Pick from light, dark, and botanical themes, adjust text size, and settle into a journal that fits you.',
  },
  {
    number: '05',
    title: 'Bring your history along',
    copy: 'Back up and restore your journal, or import entries from Tackbok, Gratitude App, and Presently.',
  },
  {
    number: '06',
    title: 'Write in your language',
    copy: 'Use English, German, Chinese, Arabic, Hebrew, with RTL support included. More languages are coming soon.',
  },
];
---

<Layout image="/og.png">
  <SiteHeader />

  <main id="main-content">
    <section
      class="relative overflow-hidden py-[clamp(4rem,8vw,7rem)] pb-[clamp(5rem,9vw,8rem)] max-sm:pt-[3.4rem]"
    >
      <div
        class="pointer-events-none absolute top-[15%] -right-48 size-[34rem] rounded-full bg-[radial-gradient(circle,rgba(163,178,125,0.36),transparent_70%)] blur-[1px]"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute bottom-[-22rem] left-[18%] size-[42rem] rounded-full bg-[radial-gradient(circle,rgba(233,208,146,0.28),transparent_70%)] blur-[1px]"
        aria-hidden="true"
      >
      </div>
      <div
        class="mx-auto grid w-[calc(100%_-_40px)] max-w-[1180px] grid-cols-[minmax(0,0.94fr)_minmax(420px,1.06fr)] items-center gap-[clamp(2rem,7vw,6rem)] max-[900px]:grid-cols-1 max-sm:w-[calc(100%_-_28px)]"
      >
        <div
          class="relative z-[2] max-[900px]:mx-auto max-[900px]:max-w-[760px] max-[900px]:text-center"
        >
          <p
            class="mb-4 flex items-center gap-[0.65rem] text-[0.76rem] font-extrabold tracking-[0.16em] text-sage uppercase max-[900px]:justify-center"
          >
            <span class="h-px w-[1.7rem] bg-sage" aria-hidden="true"></span> Private by design
          </p>
          <h1
            class="mb-[1.6rem] max-w-[690px] text-[clamp(3.35rem,6.5vw,6.1rem)] leading-[0.96] font-[720] tracking-[-0.065em] max-sm:text-[clamp(3rem,15vw,4.4rem)]"
          >
            A quieter place for the things you’re <em
              class="font-display font-medium text-sage">grateful for.</em
            >
          </h1>
          <p
            class="mb-[1.9rem] max-w-[610px] text-[clamp(1.08rem,1.8vw,1.3rem)] leading-[1.65] text-ink-soft max-[900px]:mx-auto"
          >
            Tackbok is a free, open-source gratitude journal for words, photos, and voice
            memories. No account. No ads. Your journal stays on your device.
          </p>

          <div id="download" class="flex flex-wrap gap-[0.7rem]">
            <a
              class="inline-flex h-[58px] w-[196px] items-center justify-center rounded-[8px] no-underline shadow-[0_10px_24px_rgba(52,75,55,0.17)] transition duration-150 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_rgba(52,75,55,0.25)] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[color-mix(in_srgb,var(--sage)_58%,white)] max-sm:w-full"
              href={GOOGLE_PLAY_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Get the Tackbok beta version on Google Play Store"
            >
              <span
                class="inline-flex size-full items-center justify-start gap-[0.65rem] rounded-[inherit] border border-[#a6a6a6] bg-black px-3 py-[0.48rem] text-left text-white"
              >
                <img
                  class="size-10 flex-none"
                  src="/badges/google-play.svg"
                  width="96"
                  height="96"
                  alt=""
                />
                <span class="flex min-w-0 flex-col">
                  <small
                    class="text-[0.58rem] leading-[1.05] font-semibold tracking-[0.015em] uppercase"
                    >Get beta version on</small
                  >
                  <strong class="text-[0.92rem] leading-[1.15] tracking-[-0.025em]"
                    >Google Play Store</strong
                  >
                </span>
              </span>
            </a>
            <a
              class="inline-flex h-[58px] w-[196px] items-center justify-start gap-[0.65rem] rounded-[8px] border border-[#a6a6a6] bg-black px-3 py-[0.48rem] text-left text-white no-underline shadow-[0_10px_24px_rgba(52,75,55,0.17)] transition duration-150 hover:-translate-y-0.5 hover:shadow-[0_14px_30px_rgba(52,75,55,0.25)] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[color-mix(in_srgb,var(--sage)_58%,white)] max-sm:w-full"
              href={TESTFLIGHT_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Join the Tackbok beta with TestFlight"
            >
              <img
                class="size-10 flex-none rounded-[9px]"
                src="/badges/testflight.png"
                width="400"
                height="400"
                alt=""
              />
              <span class="flex min-w-0 flex-col">
                <small
                  class="text-[0.58rem] leading-[1.05] font-semibold tracking-[0.015em] uppercase"
                  >Join the beta with</small
                >
                <strong class="text-[1.05rem] leading-[1.15] tracking-[-0.025em]"
                  >TestFlight</strong
                >
              </span>
            </a>
          </div>

          <p class="mt-4 mb-0 text-[0.82rem] text-ink-soft">
            Get the Android beta or join the iOS beta · <a
              class="font-bold underline-offset-4"
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer">explore the source on GitHub</a
            >
          </p>
        </div>

        <div
          class="phone-stage relative isolate min-h-[590px] max-[900px]:mx-auto max-[900px]:w-full max-[900px]:max-w-[650px] max-sm:min-h-[480px]"
          aria-label="Screenshots of Tackbok’s home and entry screens"
        >
          <div
            class="botanical-line bottom-[2%] left-0 -rotate-28 max-sm:hidden"
            aria-hidden="true"
          >
          </div>
          <div
            class="botanical-line top-[2%] right-[6%] rotate-[154deg] max-sm:hidden"
            aria-hidden="true"
          >
          </div>
          <div
            class="absolute top-[1%] left-[8%] z-[2] w-[min(49%,300px)] -rotate-4 overflow-hidden rounded-[2.7rem] border-4 border-[rgba(255,255,255,0.7)] bg-[#d9d7a6] shadow-[0_35px_80px_rgba(46,58,40,0.2)] max-sm:left-[1%] max-sm:w-[54%] max-sm:rounded-[2.1rem] max-sm:border-[3px]"
          >
            <Image
              class="block h-auto w-full"
              src={tackbokHomeSrc}
              alt="Tackbok home timeline showing gratitude entries"
              loading="eager"
              widths={[260, 360, 450]}
              sizes="(max-width: 640px) 230px, 300px"
            />
          </div>
          <div
            class="absolute right-[4%] bottom-0 z-[1] w-[min(45%,276px)] rotate-5 overflow-hidden rounded-[2.7rem] border-4 border-[rgba(255,255,255,0.7)] bg-[#d9d7a6] shadow-[0_35px_80px_rgba(46,58,40,0.2)] max-sm:right-0 max-sm:w-1/2 max-sm:rounded-[2.1rem] max-sm:border-[3px]"
          >
            <Image
              class="block h-auto w-full"
              src={tackbokEditSrc}
              alt="Tackbok entry editor with writing and media controls"
              loading="eager"
              widths={[260, 360, 450]}
              sizes="(max-width: 640px) 210px, 280px"
            />
          </div>
          <div
            class="absolute top-[11%] right-[1%] z-[4] flex size-[154px] rotate-7 flex-col items-center justify-center rounded-full border border-[rgba(52,75,55,0.16)] bg-[rgba(255,253,244,0.92)] text-center text-sage-deep shadow-[0_18px_50px_rgba(52,75,55,0.14)] max-sm:top-[3%] max-sm:-right-[1%] max-sm:size-28"
          >
            <span class="mb-1 text-[#9a7e45]" aria-hidden="true">✦</span>
            <strong
              class="max-w-[110px] font-display text-base leading-[1.15] max-sm:text-[0.78rem]"
              >Yours means yours</strong
            >
            <small class="mt-[0.35rem] text-[0.64rem] text-ink-soft max-sm:text-[0.55rem]"
              >Stored on your device</small
            >
          </div>
        </div>
      </div>
    </section>

    <section
      class="border-y border-line bg-[rgba(255,255,255,0.25)]"
      aria-label="Tackbok principles"
    >
      <div
        class="mx-auto grid w-[calc(100%_-_40px)] max-w-[1180px] grid-cols-4 max-sm:w-[calc(100%_-_28px)] max-sm:grid-cols-2"
      >
        <p
          class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-l border-line text-center text-[0.85rem] font-bold text-ink-soft max-sm:border-b"
        >
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">✓</span
          >
          Free &amp; open source
        </p>
        <p
          class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-l border-line text-center text-[0.85rem] font-bold text-ink-soft max-sm:border-r max-sm:border-b"
        >
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">✓</span
          >
          Works offline
        </p>
        <p
          class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-l border-line text-center text-[0.85rem] font-bold text-ink-soft"
        >
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">✓</span
          >
          No account required
        </p>
        <p
          class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-x border-line text-center text-[0.85rem] font-bold text-ink-soft"
        >
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">✓</span
          >
          No ads
        </p>
      </div>
    </section>

    <section
      id="features"
      class="bg-[linear-gradient(rgba(52,75,55,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(52,75,55,0.035)_1px,transparent_1px),var(--cream)] bg-[length:40px_40px] py-[clamp(5rem,10vw,8.5rem)]"
    >
      <div
        class="mx-auto w-[calc(100%_-_40px)] max-w-[1180px] max-sm:w-[calc(100%_-_28px)]"
      >
        <div class="mx-auto mb-[clamp(2.8rem,6vw,5rem)] max-w-[690px] text-center">
          <p
            class="mb-4 text-[0.76rem] font-extrabold tracking-[0.16em] text-sage uppercase"
          >
            A journal with room for real life
          </p>
          <h2
            class="mb-5 text-[clamp(2.35rem,4.6vw,4.2rem)] leading-[1.03] font-[690] tracking-[-0.055em]"
          >
            More ways to remember what mattered.
          </h2>
          <p class="text-[1.08rem] leading-[1.7] text-ink-soft">
            Keep the ritual simple when you want it, and add more detail when a memory
            deserves it.
          </p>
        </div>

        <div
          class="grid grid-cols-3 gap-px overflow-hidden rounded-[2rem] border border-line bg-line shadow-[0_24px_70px_rgba(48,61,42,0.12)] max-[900px]:grid-cols-2 max-sm:grid-cols-1 max-sm:rounded-3xl"
        >
          {
            features.map((feature) => (
              <article class="min-h-[265px] bg-[rgba(255,255,255,0.64)] p-[clamp(1.6rem,3vw,2.5rem)] max-sm:min-h-0">
                <span class="mb-[3.4rem] block font-display text-[0.92rem] text-sage italic max-sm:mb-8">
                  {feature.number}
                </span>
                <h3 class="mb-3 text-[1.24rem] tracking-[-0.025em]">{feature.title}</h3>
                <p class="m-0 text-[0.95rem] leading-[1.65] text-ink-soft">
                  {feature.copy}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-[clamp(5rem,10vw,8.5rem)]">
      <div
        class="mx-auto grid w-[calc(100%_-_40px)] max-w-[1180px] grid-cols-2 items-center gap-[clamp(3rem,9vw,8rem)] max-[900px]:grid-cols-1 max-sm:w-[calc(100%_-_28px)]"
      >
        <div>
          <p
            class="mb-4 text-[0.76rem] font-extrabold tracking-[0.16em] text-sage uppercase"
          >
            A thoughtful first hello
          </p>
          <h2
            class="mb-5 text-[clamp(2.35rem,4.6vw,4.2rem)] leading-[1.03] font-[690] tracking-[-0.055em]"
          >
            Set it up once. Change anything later.
          </h2>
          <p class="max-w-[590px] text-[1.08rem] leading-[1.7] text-ink-soft">
            Tackbok’s guided setup helps you choose the language, text size, theme, and
            topics you care about. Every step is purposeful, skippable, and available
            again in settings.
          </p>

          <ol class="mt-8 mb-0 grid list-none gap-5 p-0">
            <li class="grid grid-cols-[2.4rem_1fr] items-start gap-4">
              <span
                class="flex size-[2.4rem] items-center justify-center rounded-full border border-line bg-cream font-display text-sage italic"
                >1</span
              >
              <div>
                <strong class="mb-1 block">Choose what feels comfortable</strong>
                <p class="m-0 text-[0.94rem] text-ink-soft">
                  See language, font size, and theme changes as you make them.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[2.4rem_1fr] items-start gap-4">
              <span
                class="flex size-[2.4rem] items-center justify-center rounded-full border border-line bg-cream font-display text-sage italic"
                >2</span
              >
              <div>
                <strong class="mb-1 block">Pick what you want to notice</strong>
                <p class="m-0 text-[0.94rem] text-ink-soft">
                  Focus areas shape the prompts and reminders you receive.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[2.4rem_1fr] items-start gap-4">
              <span
                class="flex size-[2.4rem] items-center justify-center rounded-full border border-line bg-cream font-display text-sage italic"
                >3</span
              >
              <div>
                <strong class="mb-1 block">Start with a little context</strong>
                <p class="m-0 text-[0.94rem] text-ink-soft">
                  Optional example entries gently show how the journal works.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <div
          class="min-h-[570px] overflow-hidden rounded-[45%_45%_2rem_2rem] border border-line bg-[radial-gradient(circle_at_50%_46%,rgba(255,255,255,0.7),transparent_28%),linear-gradient(145deg,#d8dfc2,#ece4c8)] p-[2.3rem] text-center shadow-[0_24px_70px_rgba(48,61,42,0.12)] max-[900px]:mx-auto max-[900px]:w-full max-[900px]:max-w-[600px] max-sm:min-h-[480px] max-sm:px-3"
          aria-label="A selection of Tackbok theme colours"
        >
          <p class="font-display text-[1.05rem] text-sage-deep italic">
            Made to match your mood
          </p>
          <div class="relative min-h-[460px] max-sm:min-h-[390px]">
            <span
              class="absolute top-[2%] left-[15%] flex size-[105px] flex-col items-center justify-center rounded-full border-[5px] border-[rgba(255,255,255,0.55)] bg-[#82946d] text-[0.72rem] font-bold text-white shadow-[0_14px_30px_rgba(52,75,55,0.16)] max-sm:size-[82px] max-sm:border-4 max-sm:text-[0.62rem]"
              >Clemens</span
            >
            <span
              class="absolute top-[10%] right-[7%] flex size-[105px] flex-col items-center justify-center rounded-full border-[5px] border-[rgba(255,255,255,0.55)] bg-[#30473d] text-[0.72rem] font-bold text-white shadow-[0_14px_30px_rgba(52,75,55,0.16)] max-sm:size-[82px] max-sm:border-4 max-sm:text-[0.62rem]"
              >Weckner</span
            >
            <span
              class="absolute bottom-[4%] left-[8%] flex size-[105px] flex-col items-center justify-center rounded-full border-[5px] border-[rgba(255,255,255,0.55)] bg-[#b99050] text-[0.72rem] font-bold text-white shadow-[0_14px_30px_rgba(52,75,55,0.16)] max-sm:size-[82px] max-sm:border-4 max-sm:text-[0.62rem]"
              >Warm</span
            >
            <span
              class="absolute right-[12%] bottom-[1%] flex size-[105px] flex-col items-center justify-center rounded-full border-[5px] border-[rgba(255,255,255,0.55)] bg-[#353a31] text-[0.72rem] font-bold text-white shadow-[0_14px_30px_rgba(52,75,55,0.16)] max-sm:size-[82px] max-sm:border-4 max-sm:text-[0.62rem]"
              >Dark</span
            >
            <div
              class="absolute top-1/2 left-1/2 flex size-[215px] -translate-1/2 flex-col items-center justify-center rounded-full border border-[rgba(52,75,55,0.13)] bg-[rgba(255,253,244,0.82)] shadow-[0_25px_60px_rgba(52,75,55,0.16)] max-sm:size-[180px]"
            >
              <img
                class="mb-[0.6rem] rounded-[1.7rem] max-sm:size-[74px]"
                src="/icon.png"
                width="94"
                height="94"
                alt=""
              />
              <strong class="text-[1.05rem]">13 themes</strong>
              <small class="text-ink-soft">light, dark &amp; botanical</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="privacy" class="bg-sage-deep py-[clamp(5rem,10vw,8.5rem)] text-white">
      <div
        class="mx-auto grid w-[calc(100%_-_40px)] max-w-[1180px] grid-cols-2 items-center gap-[clamp(3rem,9vw,8rem)] max-[900px]:grid-cols-1 max-sm:w-[calc(100%_-_28px)]"
      >
        <div
          class="relative min-h-[460px] overflow-hidden rounded-[2rem] border border-[rgba(255,255,255,0.22)] bg-[radial-gradient(circle_at_75%_20%,rgba(203,214,172,0.24),transparent_26%),linear-gradient(150deg,rgba(255,255,255,0.12),rgba(255,255,255,0.035))] p-[clamp(2rem,5vw,4.2rem)] after:absolute after:-right-[50px] after:-bottom-[60px] after:size-[260px] after:rounded-full after:border after:border-[rgba(255,255,255,0.14)] after:content-[''] max-[900px]:min-h-[380px] max-sm:min-h-[370px]"
        >
          <p
            class="text-[0.82rem] font-extrabold tracking-[0.11em] text-[#bdcaa3] uppercase"
          >
            A journal should feel private.
          </p>
          <blockquote
            class="my-[3.2rem] max-w-[430px] font-display text-[clamp(2rem,4vw,3.3rem)] leading-[1.15] max-sm:mb-12"
          >
            “Your entries are not our product. They are not even on our servers.”
          </blockquote>
          <a
            class="relative z-[2] text-[0.9rem] font-bold underline-offset-[0.35rem] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[color-mix(in_srgb,var(--sage)_58%,white)]"
            href="/privacy">Read the privacy policy <span aria-hidden="true">→</span></a
          >
        </div>

        <div>
          <p
            class="mb-4 text-[0.76rem] font-extrabold tracking-[0.16em] text-[#bdcaa3] uppercase"
          >
            Privacy, without the fine print
          </p>
          <h2
            class="mb-5 text-[clamp(2.35rem,4.6vw,4.2rem)] leading-[1.03] font-[690] tracking-[-0.055em]"
          >
            Your thoughts stay close to you.
          </h2>
          <p class="text-[1.08rem] leading-[1.7] text-[rgba(255,255,255,0.72)]">
            Tackbok stores journal data locally and does not ask you to create an account.
            Protect access with Face ID, Touch ID, Android biometrics, or your device
            passcode.
          </p>
          <ul class="my-8 grid list-none gap-[0.85rem] p-0">
            <li class="flex items-center gap-3 text-[rgba(255,255,255,0.9)]">
              <span
                class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-[rgba(220,226,199,0.16)] text-[0.72rem] text-sage-pale"
                aria-hidden="true">✓</span
              >
              Journal text, photos, and audio stay on-device.
            </li>
            <li class="flex items-center gap-3 text-[rgba(255,255,255,0.9)]">
              <span
                class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-[rgba(220,226,199,0.16)] text-[0.72rem] text-sage-pale"
                aria-hidden="true">✓</span
              >
              Analytics is off until you explicitly opt in.
            </li>
            <li class="flex items-center gap-3 text-[rgba(255,255,255,0.9)]">
              <span
                class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-[rgba(220,226,199,0.16)] text-[0.72rem] text-sage-pale"
                aria-hidden="true">✓</span
              >
              No journal content is collected for analytics.
            </li>
            <li class="flex items-center gap-3 text-[rgba(255,255,255,0.9)]">
              <span
                class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-[rgba(220,226,199,0.16)] text-[0.72rem] text-sage-pale"
                aria-hidden="true">✓</span
              >
              App lock hides access and the task-switcher preview.
            </li>
          </ul>
          <p class="mb-0 text-[0.78rem] leading-[1.55] text-[rgba(255,255,255,0.72)]">
            App lock is a local access gate that uses your device security; it does not
            encrypt Tackbok’s SQLite database.
          </p>
        </div>

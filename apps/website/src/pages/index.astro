---
import { Clock, ExternalLink, History, Search, Sparkles } from '@lucide/astro';
import { getImage } from 'astro:assets';
import tackbokEditSrc from '~/assets/screenshots/ios/editor-light.webp';
import tackbokHomeSrc from '~/assets/screenshots/ios/timeline-light.webp';
import worksheetSrc from '~/assets/screenshots/ios/worksheet-light.webp';
import insightsSrc from '~/assets/screenshots/ios/insights-light.webp';
import themesSrc from '~/assets/screenshots/ios/themes-light.webp';
import cloudBackupSrc from '~/assets/screenshots/ios/cloud-backup-light.webp';
import languageArSrc from '~/assets/screenshots/ios/language-ar.webp';
import appIconPoster from '~/assets/videos/app-icon-poster.webp';
import appIconMp4 from '~/assets/videos/app-icon.mp4';
import appIconWebm from '~/assets/videos/app-icon.webm';
import themesPoster from '~/assets/videos/themes-poster.webp';
import themesMp4 from '~/assets/videos/themes.mp4';
import themesWebm from '~/assets/videos/themes.webm';
import voiceNoteMp4 from '~/assets/videos/voice-note.mp4';
import voiceNoteWebm from '~/assets/videos/voice-note.webm';
import FeatureCard, {
  type Props as FeatureCardProps,
} from '~/components/FeatureCard.astro';
import PhoneFrame from '~/components/PhoneFrame.astro';
import GithubIcon from '~/components/GithubIcon.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import StoreBadges from '~/components/StoreBadges.astro';
import Layout from '~/layouts/main.astro';
import { storeLinks } from '~/lib/store-links';

const GITHUB_URL = 'https://github.com/mehradotdev/tackbok';

const features = [
  {
    number: '01',
    icon: Sparkles,
    title: 'Capture the whole memory',
    copy: 'Write freely, then add photos, voice memos, moods, and tags when words are not enough.',
  },
  {
    number: '02',
    icon: Clock,
    title: 'Build your own rhythm',
    copy: 'Set an optional daily reminder at the time that works for you. Tap it to start with a relevant prompt.',
  },
  {
    number: '03',
    icon: History,
    title: 'Bring your history along',
    copy: 'Back up and restore your journal, or import entries from Tackbok, Gratitude App, and Presently.',
  },
  {
    number: '04',
    icon: Search,
    title: 'Find any memory',
    copy: 'Search your journal, or pick a day on the calendar to go straight to it.',
  },
];

const journalCards: FeatureCardProps[] = [
  {
    eyebrow: 'Words, photos and your voice',
    title: 'Say it out loud.',
    copy: 'Record a voice note when typing feels like too much. Add photos, a mood and tags to the same entry.',
    // The recording starts on the hero's timeline screenshot, so reusing that
    // image as the poster costs no extra download.
    src: tackbokHomeSrc,
    video: { webm: voiceNoteWebm, mp4: voiceNoteMp4 },
    alt: 'A timeline entry with a seven-second voice note and two photos',
  },
  {
    eyebrow: 'A little help getting started',
    title: 'Find your first words.',
    copy: 'A thoughtful worksheet gives you somewhere to begin. Make the template your own, then take it one small moment at a time.',
    src: worksheetSrc,
    alt: 'Journaling worksheet with gratitude, affirmation, and small moments prompts, plus an option to edit the template',
  },
  {
    eyebrow: 'Good moments, rediscovered',
    title: 'Look back. Feel it again.',
    copy: 'On this day brings back what you wrote a month or years ago, next to the little moments you’ve collected along the way.',
    src: insightsSrc,
    alt: 'Insights with On this day memories from one month and four years ago, a gratitude score, streaks, and totals for entries, words, photos and voice notes',
  },
];

const everywhereCards: FeatureCardProps[] = [
  {
    eyebrow: 'Cloud backup & sync',
    title: 'On every device you use.',
    copy: 'Turn on backup and sync with your own Google Drive. It goes straight from your phone to your Drive; Tackbok’s developer never sees it.',
    src: cloudBackupSrc,
    alt: 'The Cloud backup & sync screen offering optional backup to your own Google Drive, with a Connect Google Drive button',
  },
  {
    eyebrow: '9 languages',
    title: 'In your language.',
    copy: 'Arabic, Chinese, English, German, Hebrew, Hindi and more, with full right-to-left layouts for Arabic and Hebrew.',
    src: languageArSrc,
    alt: 'Tackbok’s Appearance settings in Arabic, laid out right to left, with the language list open',
  },
  {
    eyebrow: 'App icon',
    title: 'An icon to match.',
    copy: 'Choose the icon on your home screen: the classic one or one of seven others.',
    src: appIconPoster,
    video: { webm: appIconWebm, mp4: appIconMp4 },
    alt: 'Tackbok’s app icon picker with Classic, Sage, Midnight, Ocean, Terracotta, Rose, Plum and Blueprint icons',
  },
];

const description =
  'A free, open-source gratitude journal app for iOS and Android. Works offline, with no account and no ads. Add photos, voice memos, prompts and daily reminders.';

const screenshotUrls = await Promise.all(
  [tackbokHomeSrc, tackbokEditSrc, insightsSrc, themesSrc].map(async (src) => {
    const image = await getImage({ src, width: Math.min(src.width, 1080) });
    return new URL(image.src, Astro.site).href;
  }),
);

// WebSite belongs on the home page only; Google reads it to pick the site name
// shown in search results.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://tackbok.org/#website',
      name: 'Tackbok',
      url: 'https://tackbok.org/',
      description,
    },
    {
      '@type': 'MobileApplication',
      name: 'Tackbok',
      description,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'Android, iOS',
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      downloadUrl: storeLinks.map((store) => store.url),
      screenshot: screenshotUrls,
      featureList: [
        'Gratitude entries with photos, voice memos, moods and tags',
        'Guided prompts and a journaling worksheet',
        'Optional daily reminders',
        'On this day memories and insights',
        'Works offline with no account',
        'App lock with Face ID, Touch ID or biometrics',
        'Optional backup and sync with your own Google Drive',
        'Import from Gratitude App and Presently',
        'Light, dark and illustrated themes',
        'A choice of app icons',
        '9 languages, including right-to-left Arabic and Hebrew',
      ],
      author: {
        '@type': 'Organization',
        name: 'Mehra Dot Dev',
        url: 'https://mehra.dev',
      },
      sameAs: [GITHUB_URL],
    },
  ],
};
---

<Layout structuredData={structuredData}>
  <SiteHeader />

  <main id="main-content">
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-[clamp(4rem,8vw,7rem)] pb-[clamp(5rem,9vw,8rem)] max-sm:pt-[3rem] max-sm:pb-0">
      <div
        class="pointer-events-none absolute top-[15%] -right-48 size-[34rem] rounded-full bg-[radial-gradient(circle,rgba(163,178,125,0.36),transparent_70%)] blur-[1px]"
        aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute bottom-[-22rem] left-[18%] size-[42rem] rounded-full bg-[radial-gradient(circle,rgba(233,208,146,0.28),transparent_70%)] blur-[1px]"
        aria-hidden="true"></div>
      <div class="mx-auto grid w-full max-w-[1240px] grid-cols-[minmax(0,1.22fr)_minmax(260px,0.78fr)] items-center gap-[clamp(1.5rem,3vw,4rem)] px-6 max-[900px]:grid-cols-1 sm:px-8 lg:px-12">
        <div class="relative z-[2] max-[900px]:mx-auto max-[900px]:max-w-[760px] max-[900px]:text-center">
          <p class="mb-4 text-[0.76rem] font-extrabold tracking-[0.16em] text-sage-deep uppercase">
            The private, open-source gratitude journal
          </p>
          <h1 class="mb-[1.4rem] max-w-[760px] text-[clamp(3.4rem,4.2vw+1.4rem,6.1rem)] leading-[0.96] font-[720] tracking-[-0.065em] [text-wrap:balance] max-sm:text-[clamp(2.2rem,8.5vw,3.2rem)] max-sm:leading-[1.02]">
            <span class="inline-block">A quieter place</span>
            <span class="inline-block">
              for <em class="font-display font-medium text-sage">gratitude.</em>
            </span>
          </h1>
          <p class="mb-[1.8rem] max-w-[610px] text-[clamp(1.05rem,1.8vw,1.3rem)] leading-[1.65] text-ink-soft max-[900px]:mx-auto max-sm:text-[0.98rem] max-sm:leading-[1.6]">
            Tackbok is a free, open-source gratitude journal for words, photos, and voice
            memories. No account. No ads. Your journal stays on your device.
          </p>

          <StoreBadges class="max-[900px]:justify-center" />

          <div class="mt-4 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.84rem] text-ink-soft max-[900px]:justify-center max-sm:text-[0.78rem]">
            <span class="inline-flex items-center gap-1.5 font-medium text-ink-soft">
              <span class="size-1.5 rounded-full bg-sage/60"></span>
              100% Free &amp; Open Source
            </span>
            <span class="text-sage/40 max-sm:hidden" aria-hidden="true">
              •
            </span>
            <a
              class="inline-flex items-center gap-1.5 font-semibold text-sage-deep decoration-sage/40 underline-offset-4 transition-colors duration-150 hover:text-sage hover:underline"
              href={GITHUB_URL}
              target="_blank"
              rel="noopener noreferrer">
              <GithubIcon
                width="16"
                height="16"
                class="size-3.5 text-ink-soft opacity-85"
              />
              <span>Explore source on GitHub</span>
              <ExternalLink class="size-3 text-sage/70" />
            </a>
          </div>
        </div>

        <div
          class="phone-stage relative isolate mx-auto h-[590px] w-full max-w-[480px] max-sm:h-[570px] max-sm:max-w-[300px]"
          aria-label="Tackbok timeline and entry editor screenshots">
          <div class="absolute top-3 left-0 z-20 w-[270px] -rotate-4 rounded-[2.6rem] max-sm:left-1/2 max-sm:w-[250px] max-sm:-translate-x-1/2 max-sm:rotate-0 min-[901px]:transition-all min-[901px]:duration-500 min-[901px]:ease-out min-[901px]:hover:scale-105 min-[901px]:hover:rotate-0 min-[901px]:hover:shadow-[0_42px_90px_rgba(46,58,40,0.24)]">
            <PhoneFrame
              priority
              src={tackbokHomeSrc}
              alt="Tackbok timeline with yesterday’s entry about a supportive dad, a voice note, a selfie of two people smiling and a photo of the same two at a restaurant, and a “175 days of gratitude” milestone"
            />
          </div>
          <div class="absolute top-20 right-0 z-10 w-[245px] rotate-6 rounded-[2.6rem] max-sm:hidden min-[901px]:opacity-90 min-[901px]:transition-all min-[901px]:duration-500 min-[901px]:ease-out min-[901px]:hover:z-30 min-[901px]:hover:-translate-y-12 min-[901px]:hover:rotate-0 min-[901px]:hover:opacity-100 min-[901px]:hover:shadow-[0_42px_90px_rgba(46,58,40,0.24)]">
            <PhoneFrame
              src={tackbokEditSrc}
              alt="Editing an entry with a happy mood, a voice note, a framed selfie of two people smiling, and buttons to add a mood, photo, voice note, or tag"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Principles Banner Section -->
    <section
      class="relative z-10 border-y border-line bg-sage-pale/50 backdrop-blur-md"
      aria-label="Tackbok principles">
      <div class="mx-auto grid w-full max-w-[1240px] grid-cols-4 px-6 max-sm:grid-cols-2 sm:px-8 lg:px-12">
        <p class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-l border-line text-center text-[0.85rem] font-bold text-ink-soft max-sm:border-r max-sm:border-b max-sm:border-l-0">
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">
            ✓
          </span>
          Free &amp; open source
        </p>
        <p class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-l border-line text-center text-[0.85rem] font-bold text-ink-soft max-sm:border-b max-sm:border-l-0">
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">
            ✓
          </span>
          Works offline
        </p>
        <p class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-l border-line text-center text-[0.85rem] font-bold text-ink-soft max-sm:border-r max-sm:border-l-0">
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">
            ✓
          </span>
          No account required
        </p>
        <p class="m-0 flex min-h-[74px] items-center justify-center gap-[0.55rem] border-x border-line text-center text-[0.85rem] font-bold text-ink-soft max-sm:border-l-0">
          <span
            class="inline-flex size-[1.35rem] flex-none items-center justify-center rounded-full bg-sage-pale text-[0.72rem] text-sage-deep"
            aria-hidden="true">
            ✓
          </span>
          No ads
        </p>
      </div>
    </section>

    <!-- Features Section -->
    <section class="bg-cream bg-[linear-gradient(rgba(52,75,55,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(52,75,55,0.035)_1px,transparent_1px)] bg-[length:40px_40px] py-[clamp(5rem,10vw,8.5rem)]">
      <div
        id="features"
        class="mx-auto w-full max-w-[1240px] scroll-mt-24 px-6 sm:px-8 lg:px-12">
        <div class="mx-auto mb-[clamp(2.8rem,6vw,5rem)] max-w-[690px] text-center">
          <h2 class="mb-5 text-[clamp(2.35rem,4.6vw,4.2rem)] leading-[1.03] font-[690] tracking-[-0.055em] [text-wrap:balance] max-sm:text-[clamp(1.85rem,7.5vw,2.5rem)]">
            More ways to remember what mattered.
          </h2>
          <p class="text-[1.08rem] leading-[1.7] text-ink-soft max-sm:text-[0.98rem] max-sm:leading-[1.6]">
            Keep the ritual simple when you want it, and add more detail when a memory
            deserves it.
          </p>
        </div>

        <div class="mb-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {journalCards.map((card, index) => (
            <FeatureCard
              {...card}
              class={
                index === journalCards.length - 1
                  ? 'md:col-span-2 lg:col-span-1'
                  : undefined
              }
            />
          ))}
        </div>

        <div class="grid grid-cols-2 gap-px overflow-hidden rounded-[2rem] border-4 border-line shadow-[0_24px_70px_rgba(48,61,42,0.12)] max-[900px]:grid-cols-2 max-sm:grid-cols-1 max-sm:rounded-3xl">
          {features.map((feature) => {
            const IconComponent = feature.icon;
            return (
              <article class="group relative flex min-h-[265px] flex-col justify-between bg-sage-pale/70 p-[clamp(1.6rem,3vw,2.5rem)] transition-all duration-300 hover:bg-sage-pale hover:shadow-[inset_0_0_24px_rgba(52,75,55,0.04)] max-sm:min-h-0">
                <div>
                  <div class="mb-6 flex items-center justify-between">
                    <span class="badge badge-outline border-sage/40 font-display text-[0.92rem] text-sage italic transition-colors duration-300 group-hover:border-sage group-hover:bg-sage/10">
                      {feature.number}
                    </span>
                    <div class="flex size-10 items-center justify-center rounded-xl bg-sage-pale/60 text-sage-deep transition-all duration-300 group-hover:scale-110 group-hover:bg-sage group-hover:text-cream group-hover:shadow-sm">
                      <IconComponent class="size-5" />
                    </div>
                  </div>
                  <h3 class="card-title text-[1.24rem] tracking-[-0.025em] text-ink transition-colors duration-300 group-hover:text-sage-deep">
                    {feature.title}
                  </h3>
                  <p class="m-0 text-[0.95rem] leading-[1.65] text-ink-soft">
                    {feature.copy}
                  </p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Setup & Themes Section -->
    <section class="py-[clamp(5rem,10vw,8.5rem)]">
      <div class="mx-auto grid w-full max-w-[1240px] grid-cols-2 items-center gap-[clamp(3rem,9vw,8rem)] px-6 max-[900px]:grid-cols-1 sm:px-8 lg:px-12">
        <div>
          <h2 class="mb-5 text-[clamp(2.35rem,4.6vw,4.2rem)] leading-[1.03] font-[690] tracking-[-0.055em] [text-wrap:balance] max-sm:text-[clamp(1.85rem,7.5vw,2.5rem)]">
            Make it yours.
            <br class="hidden sm:inline" /> Change anything later.
          </h2>
          <p class="max-w-[590px] text-[1.08rem] leading-[1.7] text-ink-soft max-sm:text-[0.98rem] max-sm:leading-[1.6]">
            Tackbok’s guided setup helps you pick a theme, font, and focus areas that feel
            right for you. Every step is quick, skippable, and always available to tweak
            in settings.
          </p>

          <ol class="mt-8 mb-0 grid list-none gap-5 p-0">
            <li class="grid grid-cols-[2.4rem_1fr] items-start gap-4">
              <span class="flex size-[2.4rem] items-center justify-center rounded-full border border-line bg-cream font-display text-sage italic">
                1
              </span>
              <div>
                <strong class="mb-1 block">Choose what feels comfortable</strong>
                <p class="m-0 text-[0.94rem] text-ink-soft">
                  See language, font size, and theme changes as you make them.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[2.4rem_1fr] items-start gap-4">
              <span class="flex size-[2.4rem] items-center justify-center rounded-full border border-line bg-cream font-display text-sage italic">
                2
              </span>
              <div>
                <strong class="mb-1 block">Pick what you want to notice</strong>
                <p class="m-0 text-[0.94rem] text-ink-soft">
                  Focus areas shape the prompts and reminders you receive.
                </p>
              </div>
            </li>
            <li class="grid grid-cols-[2.4rem_1fr] items-start gap-4">
              <span class="flex size-[2.4rem] items-center justify-center rounded-full border border-line bg-cream font-display text-sage italic">
                3
              </span>
              <div>
                <strong class="mb-1 block">Start with a little context</strong>
                <p class="m-0 text-[0.94rem] text-ink-soft">
                  Optional example entries gently show how the journal works.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <figure class="m-0 min-w-0 rounded-[2rem] border border-line bg-cream p-5 shadow-xl shadow-ink/10 sm:p-7">
          <figcaption class="mb-6 text-center">
            <p class="mb-2 font-display text-xl text-sage-deep italic">
              Made to match your mood
            </p>
            <p class="mb-0 text-sm text-ink-soft">
              20 themes. Quiet colours, illustrated worlds, light &amp; dark.
            </p>
          </figcaption>
          <div class="mx-auto w-[min(250px,80%)]">
            <PhoneFrame
              src={themesPoster}
              video={{ webm: themesWebm, mp4: themesMp4 }}
              alt="Tackbok’s theme picker with Light, Dark, Shiro, Shadow, Helena, and Poonam previews"
              loading="lazy"
              sizes="250px"
            />
          </div>
          <p class="mt-5 mb-0 text-center text-sm text-ink-soft">
            A different feeling, with the same familiar journal.
          </p>
        </figure>
      </div>
    </section>

    <!-- Everywhere Section -->
    <section class="border-t border-line bg-paper-deep/60 py-[clamp(5rem,10vw,8.5rem)]">
      <div class="mx-auto w-full max-w-[1240px] px-6 sm:px-8 lg:px-12">
        <div class="mx-auto mb-[clamp(2.8rem,6vw,5rem)] max-w-[690px] text-center">
          <h2 class="mb-5 text-[clamp(2.35rem,4.6vw,4.2rem)] leading-[1.03] font-[690] tracking-[-0.055em] [text-wrap:balance] max-sm:text-[clamp(1.85rem,7.5vw,2.5rem)]">
            Yours, wherever you are.
          </h2>
          <p class="text-[1.08rem] leading-[1.7] text-ink-soft max-sm:text-[0.98rem] max-sm:leading-[1.6]">
            Keep your journal safe across devices, read it in your own language, and give
            it a place on your home screen that feels like you.
          </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {everywhereCards.map((card, index) => (
            <FeatureCard
              {...card}
              class={
                index === everywhereCards.length - 1
                  ? 'md:col-span-2 lg:col-span-1'
                  : undefined
              }
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Privacy Section -->
    <section class="bg-sage-deep py-[clamp(5rem,10vw,8.5rem)] text-white">
      <div
        id="privacy"
        class="mx-auto grid w-full max-w-[1240px] scroll-mt-24 grid-cols-2 items-center gap-[clamp(3rem,9vw,8rem)] px-6 max-[900px]:grid-cols-1 sm:px-8 lg:px-12">
        <div class="relative flex min-h-[440px] flex-col justify-center overflow-hidden rounded-[2rem] border border-[rgba(255,255,255,0.22)] bg-[radial-gradient(circle_at_75%_20%,rgba(203,214,172,0.24),transparent_26%),linear-gradient(150deg,rgba(255,255,255,0.12),rgba(255,255,255,0.035))] p-[clamp(2rem,5vw,4.2rem)] after:absolute after:-right-[50px] after:-bottom-[60px] after:size-[260px] after:rounded-full after:border after:border-[rgba(255,255,255,0.14)] after:content-[''] max-[900px]:min-h-0 max-[900px]:w-full max-[900px]:max-w-[560px] max-sm:p-7">
          <p class="text-[0.82rem] font-extrabold tracking-[0.11em] text-[#bdcaa3] uppercase">
            A message from the developer
          </p>
          <blockquote class="my-5 max-w-[460px] font-display text-[clamp(1.35rem,2.2vw,1.85rem)] leading-[1.35] text-[rgba(255,255,255,0.95)]">
            “I built Tackbok because journaling shouldn’t be paywalled or ad-driven. This
            is my free, open-source gift back to society.”
          </blockquote>
          <a
            class="relative z-[2] text-[0.9rem] font-bold underline-offset-[0.35rem] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[color-mix(in_srgb,var(--color-sage)_58%,white)]"
            href="/privacy">
            Read the privacy policy <span aria-hidden="true">→</span>
          </a>
        </div>

        <div>
          <h2 class="mb-5 text-[clamp(2.35rem,4.6vw,4.2rem)] leading-[1.03] font-[690] tracking-[-0.055em] [text-wrap:balance] max-sm:text-[clamp(1.85rem,7.5vw,2.5rem)]">
            Your thoughts stay close to you.
          </h2>
          <p class="text-[1.08rem] leading-[1.7] text-[rgba(255,255,255,0.72)] max-sm:text-[0.98rem] max-sm:leading-[1.6]">
            Tackbok is local-first by default, no Tackbok account or central servers
            required. Protect your journal with Face ID, Touch ID, or biometrics, with
            optional backups to your own Google Drive.
          </p>
          <ul class="my-8 grid list-none gap-[0.85rem] p-0">
            <li class="flex items-center gap-3 text-[rgba(255,255,255,0.9)]">
              <span

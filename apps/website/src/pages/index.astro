---
import { Image } from 'astro:assets';
import tackbokHomeSrc from '~/assets/tackbok_home_page.png';
import tackbokEditSrc from '~/assets/tackbok_edit_page.png';
import Layout from '~/layouts/main.astro';
import GithubIcon from '~/components/GithubIcon.astro';

const WAITLIST_URL = 'https://forms.gle/A5bGfGJLoEipsauu6';
const GITHUB_URL = 'https://github.com/mehradotdev/tackbok';
---

<Layout>
  <main
    class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-background p-6 text-foreground sm:p-12 lg:p-24"
  >
    {/* Background embellishments */}
    <div
      class="absolute top-10 left-10 -z-10 h-32 w-32 rounded-full bg-primary/20 blur-3xl"
    >
    </div>
    <div
      class="absolute right-10 bottom-20 -z-10 h-64 w-64 rounded-full bg-secondary/30 blur-3xl"
    >
    </div>

    <div class="grid w-full max-w-5xl grid-cols-1 items-center gap-12 lg:grid-cols-2">
      {/* Text / Hero Content */}
      <div class="z-10 flex flex-col gap-6 text-center lg:text-left">
        <div
          class="mx-auto inline-flex w-fit items-center gap-2 rounded-full bg-primary/20 px-3 py-1 text-sm font-medium text-primary-foreground lg:mx-0"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
          </span>
          Coming Soon
        </div>

        <h1
          class="text-5xl font-bold tracking-tight text-foreground sm:text-6xl lg:text-7xl"
        >
          Tackbok
        </h1>
        <p
          class="mx-auto max-w-lg text-xl leading-relaxed text-muted-foreground sm:text-2xl lg:mx-0"
        >
          A free and open-source gratitude journal app. Reflect on your day, simply and
          securely.
        </p>

        {/* Call to Actions */}
        <div
          class="mx-auto mt-4 flex w-full max-w-md flex-col items-center justify-center gap-3 sm:flex-row lg:mx-0 lg:justify-start"
        >
          <a
            href={WAITLIST_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 w-full shrink-0 items-center justify-center gap-1.5 rounded-4xl border border-transparent bg-primary px-8 text-lg font-normal tracking-wider whitespace-nowrap text-white shadow-lg transition-all outline-none select-none hover:bg-primary/80 hover:shadow-xl focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 active:translate-y-px sm:w-auto"
          >
            Join the Waitlist
          </a>

          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            title="View on GitHub"
            class="inline-flex h-12 w-full shrink-0 items-center justify-center gap-2 rounded-4xl border border-border bg-input/30 px-8 text-sm font-semibold whitespace-nowrap shadow-sm transition-all outline-none select-none hover:bg-input/50 hover:text-foreground hover:shadow-md focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 active:translate-y-px sm:w-auto"
          >
            <GithubIcon width="20" height="20" />
            GitHub
          </a>
        </div>

        <div
          class="mt-8 flex justify-center gap-6 text-sm text-muted-foreground lg:justify-start"
        >
          <a
            href="/terms"
            class="underline underline-offset-4 transition-colors hover:text-foreground"
          >
            Terms of Service
          </a>
          <a
            href="/privacy"
            class="underline underline-offset-4 transition-colors hover:text-foreground"
          >
            Privacy Policy
          </a>
        </div>
      </div>

      {/* Hero Visual / Screenshots */}
      <div
        class="perspective-1000 relative z-10 mt-8 flex aspect-square w-full items-center justify-center md:aspect-video lg:mt-0 lg:aspect-square"
      >
        {/* Main Phone (Home) */}
        <Image
          src={tackbokHomeSrc}
          alt="Tackbok Home Screen"
          loading="eager"
          class="absolute z-20 w-[240px] -translate-x-4 rotate-[-4deg] rounded-[3rem] shadow-[0_0_40px_rgba(0,0,0,0.1)] transition-transform duration-500 hover:scale-105 hover:rotate-0 sm:w-[280px] sm:-translate-x-6 lg:w-[320px] lg:-translate-x-10"
        />

        {/* Secondary Phone (Edit) */}
        <Image
          src={tackbokEditSrc}
          alt="Tackbok Edit Screen"
          loading="lazy"
          class="absolute w-[240px] translate-x-10 translate-y-12 rotate-[8deg] rounded-[3rem] opacity-90 shadow-[0_0_30px_rgba(0,0,0,0.1)] transition-all duration-500 hover:z-30 hover:translate-y-0 hover:rotate-0 hover:opacity-100 sm:w-[280px] sm:translate-x-16 sm:translate-y-16 lg:w-[320px] lg:translate-x-22 lg:translate-y-20"
        />
      </div>
    </div>
  </main>
</Layout>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
</style>

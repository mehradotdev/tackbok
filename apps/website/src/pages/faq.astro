---
import SiteFooter from '~/components/SiteFooter.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import StoreBadges from '~/components/StoreBadges.astro';
import Layout from '~/layouts/main.astro';

const supportEmail = 'tackbok.support@mehra.dev';

const faqs: {
  question: string;
  answer: string;
  links?: { href: string; label: string }[];
}[] = [
  {
    question: 'What is Tackbok?',
    answer:
      'Tackbok is a free, open-source gratitude journal for iOS and Android. You can write entries, add photos and voice memos, record moods, use tags and prompts, and set optional daily reminders.',
  },
  {
    question: 'What does the name “Tackbok” mean?',
    answer:
      'The name comes from the Swedish words “tack” (meaning thanks or gratitude) and “bok” (meaning book), so Tackbok literally means a “book of thanks” or gratitude book.',
  },
  {
    question: 'Is Tackbok free?',
    answer:
      'Yes. Tackbok is free, open source, and ad-free. Optional one-time support purchases may help fund development, but they unlock no features and the journaling experience is not behind a paywall.',
  },
  {
    question: 'How does supporting Tackbok work?',
    answer:
      'The Support Tackbok screen offers four voluntary, one-time options. Prices are shown by your app store in your local currency, and every option can be purchased again. Apple or Google processes the payment, with RevenueCat helping Tackbok retrieve products and purchase results. Tackbok does not ask for your name or email and does not send a separate receipt; your app store provides the purchase record and receipt.',
  },
  {
    question: 'How can I try Tackbok?',
    answer:
      'Tackbok is available for Android on Google Play and Galaxy Store, and for iOS on the App Store.',
  },
  {
    question: 'Do I need to create an account?',
    answer:
      'No. Tackbok does not require an account, email address, or cloud profile to keep a journal.',
  },
  {
    question: 'Does Tackbok work offline?',
    answer:
      'Yes. The core journal works offline and your entries are stored locally on your device. Internet access may be needed for optional services such as updates, cloud backup, or support purchases.',
  },
  {
    question: 'Where is my journal data stored?',
    answer:
      'Journal entries, photos, and voice memos are stored on your device. Tackbok’s developers do not operate a server that holds or reads your journal content. If you turn on Google Drive backup, a copy goes straight from your device to a private folder in your own Google Drive. We never receive it.',
  },
  {
    question: 'Can I lock the app?',
    answer:
      'Yes. App lock can require Face ID, Touch ID, Android biometrics, or your device PIN, pattern, or passcode. It is an access gate and privacy cover; it does not encrypt the underlying SQLite database.',
  },
  {
    question: 'Does Tackbok use analytics?',
    answer:
      'Only if you explicitly opt in. Analytics is off by default and does not collect journal text, photos, audio, tag names, your name, or your email. You can turn it off again in settings.',
  },
  {
    question: 'Can I back up or move my journal?',
    answer:
      'Yes. You can back up your journal to your own Google Drive and keep it in sync between your devices, or save a backup file yourself. You can also import entries from a Tackbok backup, Gratitude App, or Presently. Android exports can be saved to a location you choose.',
  },
  {
    question: 'How do I move my journal to a new phone?',
    answer:
      'Before you switch, turn on Cloud backup & sync (Google Drive) in Settings › Backup & restore and wait until it says it’s up to date, or export a backup file and keep it somewhere you can reach from the new phone. On the new phone, install Tackbok and restore from Google Drive or import the file. On Android, the phone’s own transfer doesn’t bring your Tackbok journal across, so do this before you move.',
  },
  {
    question: 'How do I delete my Tackbok backup from Google Drive?',
    answer:
      'In Tackbok, open Settings › Backup & restore › Cloud backup & sync › Delete or reset data. If deleting from Tackbok can’t finish, first disconnect Google Drive in Tackbok on every device, so none of them backs up again. Then open Google Drive on the web, go to Settings › Manage apps, find Tackbok, and choose Options › Delete hidden app data. The journal on your devices stays as it is.',
  },
  {
    question: 'How do I move my journal from Presently or the Gratitude app?',
    answer:
      'Export your journal from the other app, then import the file in Tackbok under Settings › Backup & restore. Presently exports a CSV file with your entry dates and text. The Gratitude app exports a ZIP file, and Tackbok brings across its entries, photos, and voice recordings. The step-by-step guides explain what comes across and what does not.',
    links: [
      { href: '/import/presently', label: 'Import from Presently' },
      { href: '/import/gratitude-app', label: 'Import from Gratitude app' },
    ],
  },
  {
    question: 'What languages does Tackbok support?',
    answer:
      'Tackbok supports 10 languages: English, Arabic, Simplified Chinese, Traditional Chinese, German, Hebrew, Hindi, Italian, Spanish, and Swedish. Arabic and Hebrew layouts include right-to-left support.',
  },
  {
    question: 'How do reminders work?',
    answer:
      'You choose whether to enable a daily reminder and when it should arrive. Reminder prompts can reflect your selected focus areas, and tapping one opens a new entry with the prompt ready.',
  },
  {
    question: 'Can I contribute or inspect the source code?',
    answer:
      'Yes. Tackbok is licensed under the Apache License 2.0 and developed in public on GitHub. You can inspect the code, report issues, and contribute improvements.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<Layout
  title="Tackbok Gratitude Journal FAQ — Free, Private & Offline"
  description="Answers about Tackbok, the free gratitude journal app for iOS and Android: offline storage, no ads, privacy, app lock, backups, languages and reminders."
  structuredData={structuredData}>
  <SiteHeader currentPath="/faq" />

  <main id="main-content" class="bg-paper">
    <section class="overflow-hidden border-b border-line bg-paper bg-[radial-gradient(circle_at_85%_20%,rgba(140,159,111,0.28),transparent_23rem),radial-gradient(circle_at_5%_95%,rgba(227,205,151,0.26),transparent_22rem)] py-[clamp(5rem,10vw,8rem)]">
      <div class="mx-auto w-full max-w-[820px] px-6 text-center sm:px-8">
        <h1 class="mx-auto mb-5 text-[clamp(3rem,7vw,5.7rem)] leading-[1.03] font-[690] tracking-[-0.055em]">
          Tackbok gratitude journal FAQ
        </h1>
        <p class="mx-auto max-w-[660px] text-[1.08rem] leading-[1.7] text-ink-soft">
          The short version: Tackbok is a free, private, account-free gratitude journal.
          Here is everything else you may want to know.
        </p>
      </div>
    </section>

    <section class="py-[clamp(4.5rem,9vw,8rem)]">
      <div class="mx-auto grid w-[calc(100%_-_40px)] max-w-[1180px] grid-cols-[minmax(230px,0.64fr)_minmax(0,1.36fr)] items-start gap-[clamp(3rem,9vw,8rem)] max-[900px]:grid-cols-1 max-sm:w-[calc(100%_-_28px)]">
        <div class="sticky top-[116px] max-[900px]:static max-[900px]:max-w-[620px]">
          <h2 class="mb-5 text-[clamp(2rem,3.7vw,3.2rem)] leading-[1.03] font-[690] tracking-[-0.055em]">
            Clear answers, no evasive language.
          </h2>
          <p class="text-[1.08rem] leading-[1.7] text-ink-soft">
            Can’t find what you need? Email us and you’ll reach the person building the
            app.
          </p>
          <a
            class="inline-flex items-center gap-[0.45rem] font-[750] text-sage-deep underline-offset-[0.35rem] focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-[color-mix(in_srgb,var(--color-sage)_58%,white)]"
            href={`mailto:${supportEmail}`}>
            Contact support <span>→</span>
          </a>
        </div>

        <div class="flex w-full flex-col gap-3.5">
          {faqs.map((faq, index) => (
            <div class="collapse-plus collapse rounded-2xl border border-[rgba(52,75,55,0.15)] bg-paper/50 transition-all duration-200 hover:border-sage/40 hover:bg-paper hover:shadow-sm has-[:checked]:border-sage/50 has-[:checked]:bg-paper has-[:checked]:shadow-[0_6px_24px_rgba(52,75,55,0.07)]">
              <input type="radio" name="faq-accordion" checked={index === 0} />
              <div class="collapse-title flex min-h-[64px] items-center pr-12 pl-6 text-[1.05rem] font-[750] text-ink sm:pr-14 sm:pl-7">
                {faq.question}
              </div>
              <div class="collapse-content pr-8 pl-6 text-[0.98rem] leading-[1.72] text-ink-soft sm:pr-10 sm:pl-7">
                <p class="max-w-[680px] pt-1 pb-4">{faq.answer}</p>
                {faq.links && (
                  <ul class="flex flex-wrap gap-x-6 gap-y-2 pb-4">
                    {faq.links.map((link) => (
                      <li>
                        <a
                          class="font-[750] text-sage-deep underline underline-offset-4 hover:text-ink"
                          href={link.href}>
                          {link.label} <span aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-paper py-[clamp(3.5rem,8vw,6rem)]">
      <div class="mx-auto flex w-[calc(100%_-_40px)] max-w-[1180px] items-center justify-between gap-8 max-sm:w-[calc(100%_-_28px)] max-sm:flex-col">
        <div class="max-sm:text-center">
          <p class="mb-4 text-[0.76rem] font-extrabold tracking-[0.16em] text-sage uppercase">
            Ready when you are
          </p>
          <h2 class="m-0 text-[clamp(2rem,4vw,3.5rem)] leading-[1.03] font-[690] tracking-[-0.055em]">
            Try Tackbok.
          </h2>
        </div>
        <StoreBadges class="justify-end max-sm:w-full max-sm:justify-center" />
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

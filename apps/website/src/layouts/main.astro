---
import '~/styles/global.css';
import Analytics from '~/components/Analytics.astro';
import { getImage } from 'astro:assets';
import defaultSocialImage from '~/assets/og.png';
import { pagePath } from '~/lib/page-path';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = 'Tackbok — Free, Private & Offline Gratitude Journal App',
  description = 'A free, open-source gratitude journal app for iOS and Android. Works offline, with no account and no ads. Add photos, voice memos, prompts and daily reminders.',
  noIndex = false,
  structuredData,
} = Astro.props;

const canonicalUrl = new URL(pagePath(Astro.url.pathname), Astro.site).href;
const socialImage = await getImage({ src: defaultSocialImage, format: 'jpg' });
const socialImageUrl = new URL(socialImage.src, Astro.site).href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={noIndex ? 'noindex' : 'max-image-preview:large'} />
    <meta name="theme-color" content="#e8e5cf" />
    <!-- Safari Smart App Banner -->
    <meta name="apple-itunes-app" content="app-id=6757330507" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tackbok" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(defaultSocialImage.width)} />
    <meta property="og:image:height" content={String(defaultSocialImage.height)} />
    <meta property="og:image:alt" content="Tackbok, a private gratitude journal" />

    <!-- Twitter (title, description and image fall back to the og: tags) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content="Tackbok, a private gratitude journal" />

    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>

{
  "name": "tackbok-monorepo",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "bun --filter '@tackbok/website' build",
    "dev": "bun --filter '@tackbok/website' dev",
    "lint": "bun --filter '*' lint",
    "start": "bun --filter '@tackbok/mobile' start",
    "test": "bun --filter '@tackbok/mobile' test",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}

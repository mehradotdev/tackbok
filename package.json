{
  "name": "tackbok-monorepo",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "tailwindcss": "^4.3.4",
      "typescript": "~6.0.3"
    }
  },
  "scripts": {
    "prepare": "husky",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "build": "bun --filter '@tackbok/website' build",
    "dev": "bun --filter '@tackbok/website' dev",
    "lint": "bun --filter '*' lint",
    "start": "bun --filter '@tackbok/mobile' start",
    "test": "bun --filter '*' --if-present test",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "0.76.0"
  },
  "patchedDependencies": {
    "react-native-skia@3.9.1": "patches/react-native-skia@3.9.1.patch"
  }
}

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "printWidth": 90,
  "tabWidth": 2,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "bracketSameLine": true,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["apps/website/**"],
      "options": {
        "sortTailwindcss": {
          "stylesheet": "apps/website/src/styles/global.css",
          "functions": ["cn", "cva"]
        },
        "astro": {}
      }
    }
  ],
  "ignorePatterns": [
    "bun.lock",
    "package-lock.json",
    "yarn.lock",
    "pnpm-lock.yaml",
    ".gitignore",
    "node_modules/",
    ".turbo/",
    ".fontenv/",
    "coverage/",
    ".pnpm-store/",
    ".expo/",
    "dist/",
    "web-build/",
    "android/",
    "ios/",
    "expo-env.d.ts",
    ".astro/",
    ".env*",
    "**/*.generated.*",
    "apps/mobile/src/lib/theme/registry.*",
    "apps/mobile/src/global.css",
    "apps/mobile/src/uniwind-types.d.ts",
    "apps/mobile/src/drizzle/",
    ".agents/skills/",
    ".husky/_/",
    ".wrangler/"
  ]
}

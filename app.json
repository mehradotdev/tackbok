{
  "expo": {
    "name": "tackbok",
    "slug": "tackbok",
    "scheme": "tackbok",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3cba8280-4616-4cf9-8309-62ce7d14da81"
      }
    },
    "owner": "mehradotdev",
    "android": {
      "package": "dev.mehra.tackbok"
    },
    "ios": {
      "bundleIdentifier": "dev.mehra.tackbok",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
